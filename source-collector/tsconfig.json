{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "plugins": [{ "name": "@effect/tsgo" }]
  },
  "include": ["src/**/*.ts", "bin/**/*.ts", "test/**/*.ts"]
}
