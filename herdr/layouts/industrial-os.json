{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    17,
    10
  ],
  "background": "canvas",
  "terminal_padding": [
    0,
    0
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 300
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 130
          },
          "window_drag": true,
          "content": {
            "mod": "industrial-os",
            "props": {
              "part": "top"
            }
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "industrial-os",
              "type": "block",
              "content": {
                "mod": "industrial-os"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 46
          },
          "content": {
            "mod": "industrial-os",
            "props": {
              "part": "bottom"
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 0,
                  "background": "background",
                  "lone": true,
                  "header": {
                    "content": {
                      "mod": "industrial-os",
                      "props": {
                        "part": "plate"
                      }
                    },
                    "height": 130,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    },
    {
      "id": "lunalee",
      "type": "column",
      "size": {
        "px": 580
      },
      "min": 420,
      "max": 900,
      "background": "chrome",
      "children": [
        {
          "id": "lunalee-host",
          "type": "block",
          "size": {
            "px": 1
          },
          "content": {
            "mod": "lunalee"
          }
        },
        {
          "id": "lunalee-chat",
          "type": "block",
          "content": {
            "terminal": "lunalee-chat"
          }
        }
      ]
    }
  ]
}
